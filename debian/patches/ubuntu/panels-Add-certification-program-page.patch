+@service.interface("com.ubuntu.hwctl")
+class HWCTL:
+    def GetCertificationStatus(self, source, server_url):
+        global current_test
+        global tests
+        global remote_access_enabled
+
+        test = tests[current_test]
+
+        print(f'Received GetCertificationStatus with {source} and {server_url}')
+        assert(source == test["client_source"])
+        assert(server_url == test["client_server_url"])
+        return {
+            "state": {
+                "status": test["status"],
+                "stale": test["stale"],
+                "certified_url": test["url"],
+                "remote_access_enabled": remote_access_enabled,
+                "valid_cache": True,
+                "source": test["source"],
+                "available_releases": None,
+                "stale_reason": "",
+                "hardware_mismatch": False,
+                "server_url": "",
+            }
+        }
+
+    def SetRemoteAccess(self, enabled):
+        global current_test
+        global remote_access_enabled
+
+        print(f"Setting remote access {enabled}")
+        remote_access_enabled = enabled
+        return {}
+
+    def launch_test(self, params):
+        testpath = os.path.join(os.getenv("BUILDDIR"), "test-certified-ubuntu")
+        subprocess.Popen(testpath)
+
+class ServiceRequestHandler(varlink.RequestHandler):
+    service = service
+
+
+def run_test(test_number):
+    global current_test
+    global tests
+
+    current_test = test_number
+    assert(current_test < len(tests))
+
+    try:
+        os.remove(os.getenv("HWCTL_SOCKET_PATH"))
+    except:
+        pass
+
+    class VarlinkServer(threading.Thread):
+        def run(self):
+            server.serve_forever()
+
+    server = varlink.ThreadingServer("unix:"+os.getenv("HWCTL_SOCKET_PATH"), ServiceRequestHandler)
+    vserver = VarlinkServer()
+    vserver.start()
+
+    test = tests[current_test]
+
+    params = [os.path.join(build_path, 'test-certified-ubuntu')]+test["client_parameters"]
+    result = subprocess.run(params, capture_output=True, text=True)
+    assert(result.returncode == test["client_return_code"])
+
+    output = result.stdout.split("\n")
+    print("Output:")
+    print(output)
+    for line in output:
+        params = line.split(":")
+        if len(params) != 2:
+            continue
+        key = params[0].strip()
+        val = params[1].strip()
+        if (key not in test["client_output"]) or (test["client_output"][key] != val):
+            print(f"Failed {test["client_output"][key]} == {val}")
+            server.shutdown()
+            vserver.join()
+            sys.exit(-1)
+
+    server.shutdown()
+    vserver.join()
+
+if len(sys.argv) == 3:
+    for t in range(len(tests)):
+        print(f"Running test {t}")
+        run_test(t)
+    sys.exit(0)
+
+os.remove(os.getenv("HWCTL_SOCKET_PATH"))
+current_test = int(sys.argv[3])
+
+server = varlink.ThreadingServer("unix:"+os.getenv("HWCTL_SOCKET_PATH"), ServiceRequestHandler)
+server.serve_forever()
