+
+
+#include "cc-ubuntu-certified-page.h"
+
+#include <config.h>
+#include <glib/gi18n.h>
+#include <../certification-client.h>
+
+
+#define CERTIFIED_LOGO "/org/canonical/ubuntu-certified/assets/certified-logo.svg"
+
+struct _CcUbuntuCertifiedPage
+{
+    AdwNavigationPage parent_instance;
+
+    GtkWidget *certified_logo;
+    GtkWidget *certified_logo_group;
+    GtkWidget *current_status_certified;
+    GtkWidget *current_status_certified_image_exists;
+    GtkWidget *current_status_related_certified_systems_exists;
+    GtkWidget *current_status_not_seen;
+    GtkWidget *current_status_api_not_available;
+    GtkWidget *current_status_unknown;
+    GtkWidget *current_status_checking;
+    GtkWidget *current_status_enable_checking;
+
+    CertificationClient *certification_client;
+
+    char *certified_url;
+
+    CertificationStatus current_status;
+
+    gulong enabled_switch_id;
+};
+
+G_DEFINE_TYPE (CcUbuntuCertifiedPage, cc_ubuntu_certified_page, ADW_TYPE_NAVIGATION_PAGE)
+
+static void launch_certification (CcUbuntuCertifiedPage *self);
+
+static void
+set_status (CcUbuntuCertifiedPage *self, CertificationStatus status)
+{
+    self->current_status = status;
+
+    gtk_widget_set_visible (self->current_status_certified,
+                            status == CERTIFICATION_STATUS_CERTIFIED);
+    gtk_widget_set_visible (self->current_status_certified_image_exists,
+                            status == CERTIFICATION_STATUS_CERTIFIED_IMAGE_EXISTS);
+    gtk_widget_set_visible (self->current_status_related_certified_systems_exists,
+                            status == CERTIFICATION_STATUS_RELATED_CERTIFIED_SYSTEM_EXISTS);
+    gtk_widget_set_visible (self->current_status_not_seen,
+                            status == CERTIFICATION_STATUS_NOT_SEEN);
+    gtk_widget_set_visible (self->current_status_api_not_available,
+                            status == CERTIFICATION_STATUS_API_NOT_AVAILABLE);
+    gtk_widget_set_visible (self->current_status_checking,
+                            status == CERTIFICATION_STATUS_CHECKING);
+    gtk_widget_set_visible (self->certified_logo_group,
+                            status == CERTIFICATION_STATUS_CERTIFIED);
+    gtk_widget_set_visible (self->current_status_unknown,
+                            status == CERTIFICATION_STATUS_UNKNOWN);
+}
+
+static void
+remote_access_cb (CertificationClient *obj, GAsyncResult *res, gpointer user_data)
+{
+    CcUbuntuCertifiedPage *self = CC_UBUNTU_CERTIFIED_PAGE (user_data);
+
+    if (!certification_client_set_remote_access_finish (obj, res, NULL)) {
+        return;
+    }
+
+    if (certification_client_get_remote_access_enabled (self->certification_client))
+        launch_certification (self);
+    else
+        set_status (self, CERTIFICATION_STATUS_UNKNOWN);
+}
+
+static void
+update_enable_checking_switch (CcUbuntuCertifiedPage *self, bool state)
+{
+    g_signal_handler_block (self->current_status_enable_checking, self->enabled_switch_id);
+    adw_switch_row_set_active (ADW_SWITCH_ROW (self->current_status_enable_checking), state);
+    g_signal_handler_unblock (self->current_status_enable_checking, self->enabled_switch_id);
+}
+
+static void
+updated_state_cb (CertificationClient *obj, GAsyncResult *res, gpointer user_data)
+{
+    CcUbuntuCertifiedPage *self = CC_UBUNTU_CERTIFIED_PAGE (user_data);
+
+    if (!certification_client_update_certification_status_finish (obj, res, NULL)) {
+        set_status (self, CERTIFICATION_STATUS_API_NOT_AVAILABLE);
+        return;
+    }
+
+    if (certification_client_get_stale (self->certification_client)) {
+        set_status (self, CERTIFICATION_STATUS_API_NOT_AVAILABLE);
+        return;
+    }
+    CertificationStatus current_status = certification_client_get_certification_status (self->certification_client);
+    set_status (self, current_status);
+    switch (current_status) {
+        case CERTIFICATION_STATUS_CERTIFIED:
+        case CERTIFICATION_STATUS_CERTIFIED_IMAGE_EXISTS:
+        case CERTIFICATION_STATUS_RELATED_CERTIFIED_SYSTEM_EXISTS:
+            g_clear_pointer (&self->certified_url, g_free);
+            self->certified_url = g_strdup (certification_client_get_certified_url (self->certification_client));
+            break;
+        default:
+            break;
+    }
+}
+
+
+static void
+launch_certification (CcUbuntuCertifiedPage *self)
+{
+    g_autoptr(GError) error = NULL;
+
+    g_clear_pointer (&self->certified_url, g_free);
+
+    set_status (self, CERTIFICATION_STATUS_CHECKING);
+
+    const gchar *server_url = g_getenv ("CERTIFICATION_SERVER_URL");
+
+    certification_client_update_certification_status_async (self->certification_client,
+                                                            server_url,
+                                                            CERTIFICATION_SOURCE_AUTO,
+                                                            (GAsyncReadyCallback) updated_state_cb,
+                                                            self);
+}
+
+
+static void
+on_is_certified_clicked_cb (CcUbuntuCertifiedPage *self)
+{
+    g_app_info_launch_default_for_uri (self->certified_url, NULL, NULL);
+}
+
+
+static void
+on_certified_image_exists_clicked_cb (CcUbuntuCertifiedPage *self)
+{
+    g_app_info_launch_default_for_uri (self->certified_url, NULL, NULL);
+}
+
+
+static void
+on_related_certified_systems_exists_clicked_cb (CcUbuntuCertifiedPage *self)
+{
+    g_app_info_launch_default_for_uri (self->certified_url, NULL, NULL);
+}
+
+
+static void
+on_retry_certification_clicked_cb (CcUbuntuCertifiedPage *self)
+{
+    launch_certification (self);
+}
+
+
+#ifdef DARK_MODE_CERTIFIED_LOGO
+static gboolean
+use_dark_theme (CcUbuntuCertifiedPage *self)
+{
+    AdwStyleManager *style_manager = adw_style_manager_get_default ();
+
+    return adw_style_manager_get_dark (style_manager);
+}
+#endif
+
+
+static void
+setup_certified_logo (CcUbuntuCertifiedPage *self)
+{
+#ifdef DARK_MODE_CERTIFIED_LOGO
+    if (use_dark_theme (self)) {
+        gtk_picture_set_resource (GTK_PICTURE (self->certified_logo), DARK_MODE_CERTIFIED_LOGO);
+        return;
+    }
+#endif
+    gtk_picture_set_resource (GTK_PICTURE (self->certified_logo), CERTIFIED_LOGO);
+}
+
+
+static void
+cc_ubuntu_certified_page_dispose (GObject *object)
+{
+    CcUbuntuCertifiedPage *self = CC_UBUNTU_CERTIFIED_PAGE (object);
+
+    g_clear_object (&self->certification_client);
+
+    g_clear_pointer (&self->certified_url, g_free);
+
+    G_OBJECT_CLASS (cc_ubuntu_certified_page_parent_class)->dispose (object);
+}
+
+static void
+current_status_enable_checking_changed_cb (CcUbuntuCertifiedPage *self, GParamSpec *pspec)
+{
+    bool enabled = adw_switch_row_get_active (ADW_SWITCH_ROW (self->current_status_enable_checking));
+    certification_client_set_remote_access_async (self->certification_client,
+                                                  enabled,
+                                                  (GAsyncReadyCallback) remote_access_cb,
+                                                  self);
+}
+
+static void
+show_cb (CcUbuntuCertifiedPage *self)
+{
+    bool remote_access_enabled = certification_client_get_remote_access_enabled (self->certification_client);
+
+    update_enable_checking_switch (self, remote_access_enabled);
+
+    if (remote_access_enabled) {
+        launch_certification (self);
+    } else {
+        set_status (self, CERTIFICATION_STATUS_UNKNOWN);
+    }
+}
+
+static void
+cc_ubuntu_certified_page_class_init (CcUbuntuCertifiedPageClass *klass)
+{
+    GObjectClass *object_class = G_OBJECT_CLASS (klass);
+    GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
+    AdwNavigationPageClass *panel_class = ADW_NAVIGATION_PAGE_CLASS (klass);
+
