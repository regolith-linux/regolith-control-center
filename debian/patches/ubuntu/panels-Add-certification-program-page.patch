new file mode 100644
index 0000000..e8df796
--- /dev/null
+++ b/tests/certified_ubuntu/test-certified-ubuntu.c
@@ -0,0 +1,140 @@
+#include "certification-client.h"
+#include <glib-object.h>
+#include <glib.h>
+#include <gio/gio.h>
+
+static int e_argc;
+static char **e_argv;
+
+void do_test (GApplication *, gpointer);
+void data_changed (CertificationClient *, GApplication *);
+void test0(CertificationClient *);
+void test1(CertificationClient *);
+void test2(CertificationClient *);
+void test3(CertificationClient *);
+void test4(CertificationClient *, GApplication *);
+void status_cb (CertificationClient *client, GAsyncResult *res, gpointer user_data);
+
+void data_changed (CertificationClient *client, GApplication *app) {
+    g_print("Remote access enabled: %s\n", certification_client_get_remote_access_enabled (client) ? "true" : "false");
+    g_print("Stale: %s\n", certification_client_get_stale (client) ? "true" : "false");
+    g_print("Status: %d\n", certification_client_get_certification_status (client));
+    g_print("URL: '%s'\n", certification_client_get_certified_url (client));
+    g_object_unref (client);
+    g_application_release (app);
+}
+
+void status_cb (CertificationClient *client, GAsyncResult *res, gpointer user_data) {
+    g_autoptr(GError) error = NULL;
+    if (!certification_client_update_certification_status_finish (client, res, &error)) {
+        g_print("Error updating certification status: %s\n", error->message);
+        g_object_unref (client);
+        g_application_release (G_APPLICATION (user_data));
+        return;
+    }
+    data_changed (client, G_APPLICATION (user_data));
+}
+
+void test1(CertificationClient *client) {
+    g_assert(e_argc == 4);
+    CertificationSource source;
+    char *server = NULL;
+
+    if (g_str_equal (e_argv[2], "auto"))
+        source = CERTIFICATION_SOURCE_AUTO;
+    else if (g_str_equal (e_argv[2], "cache"))
+        source = CERTIFICATION_SOURCE_CACHE;
+    else if (g_str_equal (e_argv[2], "server"))
+        source = CERTIFICATION_SOURCE_SERVER;
+    else
+        exit(-1);
+
+    if (!g_str_equal (e_argv[3], "NULL"))
+        server = e_argv[3];
+
+    certification_client_update_certification_status_async(client, server, source, NULL, NULL);
+}
+
+void test2(CertificationClient *client) {
+    certification_client_set_remote_access_async (client, true, NULL, NULL);
+}
+
+void test3(CertificationClient *client) {
+    certification_client_set_remote_access_async (client, false, NULL, NULL);
+}
+
+void test4(CertificationClient *client, GApplication *app) {
+    g_assert(e_argc == 5);
+    CertificationSource source;
+    char *server = NULL;
+
+    // send several commands to the daemon, to test that the petitions are processed in order.
+    certification_client_set_remote_access_async (client, e_argv[2][0] == '1' ? true : false, NULL, NULL);
+    certification_client_set_remote_access_async (client, e_argv[2][0] == '1' ? false : true, NULL, NULL);
+    certification_client_set_remote_access_async (client, e_argv[2][0] == '1' ? true : false, NULL, NULL);
+
+    if (g_str_equal (e_argv[3], "auto"))
+        source = CERTIFICATION_SOURCE_AUTO;
+    else if (g_str_equal (e_argv[3], "cache"))
+        source = CERTIFICATION_SOURCE_CACHE;
+    else if (g_str_equal (e_argv[3], "server"))
+        source = CERTIFICATION_SOURCE_SERVER;
+    else
+        exit(-1);
+
+    if (!g_str_equal (e_argv[4], "NULL"))
+        server = e_argv[4];
+
+    certification_client_update_certification_status_async(client,
+                                                           server,
+                                                           source,
+                                                           (GAsyncReadyCallback) status_cb,
+                                                           app);
+}
+
+void do_test (GApplication *app, gpointer data) {
+    int test_n = GPOINTER_TO_INT (data);
+
+    g_application_hold(app);
+    CertificationClient *client = certification_client_get_default();
+
+
+    switch (test_n) {
+    default:
+        g_signal_connect (client, "changed", (GCallback) data_changed, app);
+        test1(client);
+        break;
+    case 2:
+        g_signal_connect (client, "changed", (GCallback) data_changed, app);
+        test2(client);
+        break;
+    case 3:
+        g_signal_connect (client, "changed", (GCallback) data_changed, app);
+        test3(client);
+        break;
+    case 4:
+        test4(client, app);
+        break;
+    }
+}
+
+int main(int argc, char **argv) {
+    int test = 0;
+    if (argc == 1) {
+        g_print("Usage:\n");
+        g_print("test-certified-ubuntu #TEST ...");
+        g_print("test-certified-ubuntu 1 CERT_S url (CERT_S = cache, server or auto)\n");
+        g_print("test-certified-ubuntu 2 -> enable remote access\n");
+        g_print("test-certified-ubuntu 3 -> disable remote access\n");
+        g_print("test-certified-ubuntu 4 0/1 CERT_S url -> 0=disable 1=enable remote access (CERT_S = cache, server or auto)\n");
+        return 0;
+    }
+    if (argc >= 2) {
+        test = atoi(argv[1]);
+    }
+    e_argc = argc;
+    e_argv = argv;
+    g_autoptr (GApplication) app = g_application_new ("com.canonical.test-certified-ubuntu", G_APPLICATION_DEFAULT_FLAGS);
+    g_signal_connect (app, "activate", (GCallback) do_test, GINT_TO_POINTER(test));
+    g_application_run (app, 1, argv);
+}
