diff --git a/panels/system/ubuntu-certified/cc-ubuntu-certified-page.blp b/panels/system/ubuntu-certified/cc-ubuntu-certified-page.blp
new file mode 100644
index 0000000..3facbd5
--- /dev/null
+++ b/panels/system/ubuntu-certified/cc-ubuntu-certified-page.blp
@@ -0,0 +1,149 @@
+using Gtk 4.0;
+using Adw 1;
+
+template $CcUbuntuCertifiedPage: Adw.NavigationPage {
+  title: _("Ubuntu Certified");
+  tag: "ubuntu-certified";
+
+  child: Adw.ToolbarView {
+    [top]
+    Adw.HeaderBar {}
+
+    content: Adw.PreferencesPage prefs_page {
+
+      Adw.PreferencesGroup certified_logo_group {
+        visible: false;
+        Adw.Clamp {
+          orientation: vertical;
+
+          child: Picture certified_logo {
+            can-shrink: false;
+            content-fit: scale_down;
+            alternative-text: _("Certified Logo");
+            visible: true;
+          };
+        }
+      }
+
+      Adw.PreferencesGroup certified_status_group {
+        visible: true;
+
+        Adw.ActionRow current_status_certified {
+          visible: false;
+          title: _("This computer is Ubuntu Certified");
+          [prefix]
+          Gtk.Image {
+            icon-name: "emblem-ok-symbolic";
+          }
+          [suffix]
+          Gtk.Image {
+            icon-name: "adw-external-link-symbolic";
+          }
+          activatable: true;
+          activated => $on_is_certified_clicked_cb(template);
+        }
+
+        Adw.ActionRow current_status_certified_image_exists {
+          visible: false;
+          title: _("This computer is certified for a different Ubuntu version");
+          [prefix]
+          Gtk.Image {
+            icon-name: "dialog-information-symbolic";
+          }
+          [suffix]
+          Gtk.Image {
+            icon-name: "adw-external-link-symbolic";
+          }
+          activatable: true;
+          activated => $on_certified_image_exists_clicked_cb(template);
+        }
+
+        Adw.ActionRow current_status_related_certified_systems_exists {
+          visible: false;
+          title: _("This computer is not Ubuntu Certified");
+          subtitle: _("A similar computer is certified, check for compatibility");
+          [prefix]
+          Gtk.Image {
+            icon-name: "dialog-information-symbolic";
+          }
+          [suffix]
+          Gtk.Image {
+            icon-name: "adw-external-link-symbolic";
+          }
+          activatable: true;
+          activated => $on_related_certified_systems_exists_clicked_cb(template);
+        }
+
+        Adw.ActionRow current_status_not_seen {
+          visible: false;
+          title: _("This computer is not Ubuntu Certified");
+          [prefix]
+          Gtk.Image {
+            icon-name: "dialog-error-symbolic";
+          }
+        }
+
+        Adw.ActionRow current_status_api_not_available {
+          visible: false;
+          title: _("Unable to check if this computer is Ubuntu Certified");
+          subtitle: _("Check your internet connection or try again later");
+          [prefix]
+          Gtk.Image {
+            icon-name: "warning-symbolic";
+          }
+          [suffix]
+          Gtk.Image {
+            icon-name: "emblem-synchronizing-symbolic";
+          }
+          activatable: true;
+          activated => $on_retry_certification_clicked_cb(template);
+        }
+
+        Adw.ActionRow current_status_checking {
+          visible: false;
+          title: _("Checking...");
+          [prefix]
+          Adw.Spinner {}
+        }
+
+        Adw.ActionRow current_status_unknown {
+          visible: true;
+          title: _("Certification status unknown");
+          [prefix]
+          Gtk.Image {
+            icon-name: "dialog-question-symbolic";
+          }
+        }
+
+        Adw.SwitchRow current_status_enable_checking {
+          title: _("Enable Ubuntu Certified checks");
+          subtitle: _("Hardware details will be sent regularly to Canonical servers to provide an accurate certification status. No personal data is included. <a href=\"https://canonical.com/legal/systems-information-notice\">Legal notice</a>");
+          activatable: true;
+        }
+      }
+
+      Adw.PreferencesGroup {
+
+        Gtk.Box {
+          orientation: vertical;
+
+          Gtk.Label label1 {
+            visible: true;
+            margin-top: 10;
+            wrap: true;
+            label: _("Certified devices are tested for reliability and performance, ensuring the best Ubuntu experience.");
+            xalign: 0;
+          }
+
+          Gtk.Label label2 {
+            visible: true;
+            margin-top: 10;
+            label: _("<a href=\"https://ubuntu.com/certified\">Learn about Ubuntu Certified</a>");
+            use-markup: true;
+            xalign: 0;
+          }
+        }
+      }
+    };
+  };
+}
\ No newline at end of file
diff --git a/panels/system/ubuntu-certified/cc-ubuntu-certified-page.c b/panels/system/ubuntu-certified/cc-ubuntu-certified-page.c
new file mode 100644
index 0000000..b9dc0af
--- /dev/null
+++ b/panels/system/ubuntu-certified/cc-ubuntu-certified-page.c
@@ -0,0 +1,287 @@
+/* -*- mode: C; c-file-style: "gnu"; indent-tabs-mode: nil; -*-
+ *
+ * Copyright (C) 2026 Canonical Ltd.
+ *
+ * This program is free software; you can redistribute it and/or modify
