+
+/*
+ * Certification Client
+ *
+ * A GObject that allows to query the certification status of the system,
+ * and to enable/disable remote access.
+ */
+
+#include "certification-client.h"
+#include <systemd/sd-varlink.h>
+#include <sys/stat.h>
+
+struct _CertificationClient {
+    GObject parent_instance;
+
+    struct sd_varlink *connection;
+
+    GTask *task;
+    GQueue *pending_calls;
+
+    CertificationStatus current_status;
+    char *certified_url;
+    bool stale;
+    bool remote_access_enabled;
+};
+
+G_DEFINE_TYPE (CertificationClient, certification_client, G_TYPE_OBJECT)
+
+static CertificationClient *default_certification_client = NULL;
+
+typedef struct {
+    const char *command;
+    sd_json_variant *parameters;
+    sd_json_variant *received_state;
+    GAsyncReadyCallback callback;
+    gpointer callback_data;
+    gpointer async_function_tag;
+} VarlinkTaskData;
+
+static void
+free_varlink_task_data (VarlinkTaskData *data)
+{
+    // The "command" field is currently a pointer to a static string,
+    // so it must not be freed.
+    // The received_state field belongs to the VarLink connection object
+    // and is freed by it when needed, so must not be freed neither.
+    sd_json_variant_unref (data->parameters);
+    g_free (data);
+}
+
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (VarlinkTaskData, free_varlink_task_data)
+
+static void send_message (CertificationClient *client, VarlinkTaskData *message);
+
+
+static const char *
+get_string_from_variant_object (sd_json_variant *variant,
+                                const char      *key)
+{
+    sd_json_variant *value = sd_json_variant_by_key (variant, key);
+    return sd_json_variant_string (value);
+}
+
+static bool
+get_boolean_from_variant_object (sd_json_variant *variant,
+                                 const char      *key)
+{
+    sd_json_variant *value = sd_json_variant_by_key (variant, key);
+    return sd_json_variant_boolean (value);
+}
+
+/*
+ * After the certification status has been obtained from the service,
+ * this function is called with the result to update the data here,
+ * in the main thread.
+ */
+static void
+update_inner_status (CertificationClient *client,
+                     sd_json_variant     *received_state)
+{
+    sd_json_variant *state = NULL;
+    const char *str_status = NULL;
+
+    state = sd_json_variant_by_key (received_state, "state");
+
+    g_free (client->certified_url);
+    client->certified_url = g_strdup (get_string_from_variant_object (state, "certified_url"));
+
+    client->stale = get_boolean_from_variant_object (state, "stale");
+    client->remote_access_enabled = get_boolean_from_variant_object (state, "remote_access_enabled");
+
+    str_status = get_string_from_variant_object (state, "status");
+    if (g_str_equal (str_status, "Certified"))
+        client->current_status = CERTIFICATION_STATUS_CERTIFIED;
+    else if (g_str_equal (str_status, "NotSeen"))
+        client->current_status = CERTIFICATION_STATUS_NOT_SEEN;
+    else if (g_str_equal (str_status, "CertifiedImageExists"))
+        client->current_status = CERTIFICATION_STATUS_CERTIFIED_IMAGE_EXISTS;
+    else if (g_str_equal (str_status, "RelatedCertifiedSystemExists"))
+        client->current_status = CERTIFICATION_STATUS_RELATED_CERTIFIED_SYSTEM_EXISTS;
+    else
+        client->current_status = CERTIFICATION_STATUS_UNKNOWN;
+}
+
+static void
+process_next_message (CertificationClient *client)
+{
+    // We must keep the task pointer until here because a client could add new
+    // messages inside the signal handler, and we are using the task pointer
+    // to know whether a message must be queued or a new task be created.
+    g_clear_object (&client->task);
+
+    if (g_queue_is_empty (client->pending_calls))
+        return;
+
+    send_message (client, g_queue_pop_head (client->pending_calls));
+}
+
+/**
+ * Performs a varlink query in an independent thread
+ * to avoid blocking the main thread. The result is processed in the task_completed()
+ * function, which updates the last_certification_status and emits the "changed" signal.
+ */
+static void
+query_varlink_method (GTask        *task,
+                      gpointer      source_object,
+                      gpointer      task_data,
+                      GCancellable *cancellable)
+{
+    sd_json_variant *out_data = NULL;
+    const char *error_id = NULL;
+    int rv;
+
+    CertificationClient *client = CERTIFICATION_CLIENT (source_object);
+    VarlinkTaskData *data = g_task_get_task_data (task);
+
+    // This call is not thread-safe, but since we are serializing all the
+    // queries, it's safe to call it from a different thread than the main one.
+    rv = sd_varlink_call (
+         client->connection,
+         data->command,
+         data->parameters,
+         &out_data,
+         &error_id
+    );
+
+    if ((rv < 0) || (error_id != NULL)) {
+        g_autoptr(GError) error = NULL;
+
+        if (error_id == NULL)
+            g_set_error (&error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                        "Failed to call certification service method %s: %s",
+                        data->command,
+                        strerror (rv));
+        else
+            g_set_error (&error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                        "Failed to call certification service method %s: %s",
+                        data->command,
+                        error_id);
+        g_warning ("%s", error->message);
+        g_task_return_error (task, g_steal_pointer (&error));
+    } else {
+        data->received_state = out_data;
+        g_task_return_boolean (task, TRUE);
+    }
+}
+
+static void
+task_completed_cb (CertificationClient *client, GAsyncResult *res, gpointer user_data)
+{
+
+    VarlinkTaskData *task_data = (VarlinkTaskData *) user_data;
+    if (!g_task_had_error (G_TASK (res))) {
+        if (g_async_result_is_tagged (res, certification_client_update_certification_status_async))
+            update_inner_status (client, task_data->received_state);
+        else if (g_async_result_is_tagged (res, certification_client_set_remote_access_async))
+            client->remote_access_enabled = get_boolean_from_variant_object (task_data->parameters, "enabled");
+    } else {
+        client->current_status = CERTIFICATION_STATUS_API_NOT_AVAILABLE;
+    }
+
+    if (task_data->callback != NULL)
+        task_data->callback (G_OBJECT (client), res, task_data->callback_data);
+
+    g_signal_emit_by_name (client, "changed");
+    process_next_message (client);
+}
+
+static void
+send_message (CertificationClient *client,
+              VarlinkTaskData     *message)
+{
+    client->task = g_task_new (client, NULL, (GAsyncReadyCallback) task_completed_cb, message);
+    g_task_set_task_data (client->task, message, (GDestroyNotify) free_varlink_task_data);
+    g_task_set_source_tag (client->task, message->async_function_tag);
+    g_task_run_in_thread (client->task, (GTaskThreadFunc) query_varlink_method);
+}
+
+static void
+enqueue_message (CertificationClient *client,
+                 VarlinkTaskData     *message)
+{
+    if (client->task != NULL)
+        g_queue_push_tail (client->pending_calls, message);
+    else
+        send_message (client, message);
+}
+
+
+/**
+ * certification_client_update_certification_status_async:
+ * @client: the #CertificationClient instance
+ * @server_url: the URL of the certification server to query. If NULL, the default
+ *   server URL will be used.
+ * @source: the source from which to retrieve the certification status. This can
+ *   be one of the following values:
+ *   - #CERTIFICATION_SOURCE_CACHE: Retrieve the status from the cache.
+ *   - #CERTIFICATION_SOURCE_SERVER: Retrieve the status from the server.
+ *   - #CERTIFICATION_SOURCE_AUTO: Automatically choose the source.
+ * @callback: a #GAsyncReadyCallback to call when the operation is finished
+ * @user_data: user data to pass to the callback
+ *
+ * Returns: true if the operation was successfully initiated, false otherwise.
+ */
+bool
+certification_client_update_certification_status_async (CertificationClient *client,
+                                                        const gchar         *server_url,
+                                                        CertificationSource  source,
+                                                        GAsyncReadyCallback  callback,
+                                                        gpointer             user_data)
+{
+    const char *source_str = NULL;
+    g_return_val_if_fail (CERTIFICATION_IS_CLIENT (client), false);
+
+    if (!certification_client_connect (client)) {
+        return false;
+    }
+
+    g_autoptr(VarlinkTaskData) data = g_new0 (VarlinkTaskData, 1);
+    data->command = "com.ubuntu.hwctl.GetCertificationStatus";
+    switch (source) {
+    case CERTIFICATION_SOURCE_CACHE:
+        source_str = "cache";
+        break;
+    case CERTIFICATION_SOURCE_SERVER:
+        source_str = "server";
+        break;
+    case CERTIFICATION_SOURCE_AUTO:
+        source_str = "auto";
+        break;
+    }
+    sd_json_variant_set_field_string (&data->parameters, "source", source_str);
+    if (server_url != NULL) {
+        sd_json_variant_set_field_string (&data->parameters, "server_url", server_url);
+    }
+    data->callback = callback;
+    data->callback_data = user_data;
+    data->async_function_tag = certification_client_update_certification_status_async;
+
+    enqueue_message (client, g_steal_pointer (&data));
+    return true;
+}
+
+/**
+ * certification_client_update_certification_status_finish:
+ * @client: the #CertificationClient instance
+ * @res: the #GAsyncResult passed to the callback
+ * @error: return location for a #GError, or NULL
+ *
+ * Finishes an asynchronous operation started with
+ * certification_client_update_certification_status_async().
+ *
+ * Returns: true if the operation was successful, false otherwise.
+ */
+bool
+certification_client_update_certification_status_finish (CertificationClient *client,
+                                                         GAsyncResult        *res,
+                                                         GError             **error)
+{
+    g_return_val_if_fail (CERTIFICATION_IS_CLIENT (client), false);
+    g_return_val_if_fail (G_IS_TASK (res), false);
+    g_return_val_if_fail (g_task_is_valid (res, client), false);
+    g_return_val_if_fail (g_async_result_is_tagged (res, certification_client_update_certification_status_async), false);
+
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+
+/**
+ * certification_client_set_remote_access_async:
+ * @client: the #CertificationClient instance
+ * @enabled: whether remote access should be enabled or disabled
+ * @callback: a #GAsyncReadyCallback to call when the operation is finished
+ * @user_data: user data to pass to the callback
+ *
+ * Sets the remote access status for the certification client.
+ *
+ * Returns: true if the operation was successfully initiated, false otherwise.
+ */
+bool
+certification_client_set_remote_access_async (CertificationClient *client,
+                                              bool                 enabled,
+                                              GAsyncReadyCallback  callback,
+                                              gpointer             user_data)
+{
+    g_return_val_if_fail (CERTIFICATION_IS_CLIENT (client), false);
+
+    if (!certification_client_connect (client)) {
+        return false;
+    }
+
+    g_autoptr(VarlinkTaskData) data = g_new0 (VarlinkTaskData, 1);
+    data->command = "com.ubuntu.hwctl.SetRemoteAccess";
+    sd_json_variant_set_field_boolean (&data->parameters, "enabled", enabled);
+    data->callback = callback;
+    data->callback_data = user_data;
+    data->async_function_tag = certification_client_set_remote_access_async;
+
+    enqueue_message (client, g_steal_pointer (&data));
+    return true;
+}
+
+/**
+ * certification_client_set_remote_access_finish:
+ * @client: the #CertificationClient instance
+ * @res: the #GAsyncResult passed to the callback
+ * @error: return location for a #GError, or NULL
+ *
+ * Finishes an asynchronous operation started with
+ * certification_client_set_remote_access_async().
+ *
+ * Returns: true if the operation was successful, false otherwise.
+ */
+bool
+certification_client_set_remote_access_finish (CertificationClient *client,
+                                               GAsyncResult        *res,
+                                               GError             **error)
+{
+    g_return_val_if_fail (CERTIFICATION_IS_CLIENT (client), false);
+    g_return_val_if_fail (G_IS_TASK (res), false);
+    g_return_val_if_fail (g_task_is_valid (res, client), false);
+    g_return_val_if_fail (g_async_result_is_tagged (res, certification_client_set_remote_access_async), false);
+
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+
+/**
+ * certification_client_get_remote_access_enabled:
+ * @client: the #CertificationClient instance
+ *
+ * Returns: true if remote access is enabled in the daemon, false otherwise.
+ */
+bool
+certification_client_get_remote_access_enabled (CertificationClient *client)
+{
+    g_return_val_if_fail (CERTIFICATION_IS_CLIENT (client), false);
+
+    return client->remote_access_enabled;
+}
+
+/**
+ * certification_client_get_stale:
+ * @client: the #CertificationClient instance
+ *
+ * Returns: true if the certification status is stale, false otherwise.
+ */
+bool
+certification_client_get_stale (CertificationClient *client)
+{
+    g_return_val_if_fail (CERTIFICATION_IS_CLIENT (client), false);
+
+    return client->stale;
+}
+
+/**
+ * certification_client_get_certification_status:
+ * @client: the #CertificationClient instance
+ *
+ * Returns: the current certification status of the client.
+ */
+CertificationStatus
+certification_client_get_certification_status (CertificationClient *client)
+{
+    g_return_val_if_fail (CERTIFICATION_IS_CLIENT (client), CERTIFICATION_STATUS_API_NOT_AVAILABLE);
+
+    return client->current_status;
+}
+
+/**
+ * certification_client_get_certified_url:
+ * @client: the #CertificationClient instance
+ *
+ * Returns: (nullable) (transfer none): the URL of the certified image, or NULL if not available.
+ */
+const char *
+certification_client_get_certified_url (CertificationClient *client)
+{
+    g_return_val_if_fail (CERTIFICATION_IS_CLIENT (client), NULL);
+
+    return client->certified_url;
+}
+
+/**
+ * certification_client_get_is_connected:
+ * @client: the #CertificationClient instance
+ *
+ * Returns: true if the client is connected to the daemon, false otherwise.
+ */
+bool
+certification_client_get_is_connected (CertificationClient *client)
+{
+    g_return_val_if_fail (CERTIFICATION_IS_CLIENT (client), false);
+
+    return client->connection != NULL;
+}
+
+static const char *
+get_socket_path (void)
+{
+    const char *socket_path;
+    struct stat statbuf;
+
+    // first, search the environment variable
+    socket_path = g_getenv ("HWCTL_SOCKET_PATH");
+    if ((socket_path != NULL) && (socket_path[0] != 0) && (stat (socket_path, &statbuf) == 0))
+        return socket_path;
+
+    // if not found, or not valid, search for the snapped socket
+    socket_path = SOCKET_PATH_SNAPPED;
+    if (stat (socket_path, &statbuf) == 0)
+        return socket_path;
+
+    // if not found, try with the unconfined socket
+    socket_path = SOCKET_PATH_UNCONFINED;
+    if (stat (socket_path, &statbuf) == 0) {
+        return socket_path;
+    }
+    return NULL;
+}
+
+/**
+ * certification_client_connect:
+ * @client: the #CertificationClient instance
+ *
+ * Connects to the certification service and returns true if the connection was
+ * successful, false otherwise. It can be used to check if the service is available.
+ *
+ * Returns: true if the connection was successful, false otherwise
+ */
+bool
+certification_client_connect (CertificationClient *client)
+{
+    const gchar *socket_path;
+
+    g_return_val_if_fail (CERTIFICATION_IS_CLIENT (client), false);
+
+    if (client->connection != NULL)
+        return true;
+
+    socket_path = get_socket_path ();
+    if (socket_path == NULL)
+        return false;
+
+    return sd_varlink_connect_address (&client->connection, socket_path) >= 0;
+}
+
+static void
+certification_client_dispose (GObject *gobject)
+{
+    CertificationClient *client = CERTIFICATION_CLIENT (gobject);
+    g_clear_object (&client->task);
+    g_clear_pointer (&client->connection, sd_varlink_unref);
+    g_clear_pointer (&client->certified_url, g_free);
+    if (client->pending_calls != NULL) {
+        g_queue_free_full (client->pending_calls, (GDestroyNotify) free_varlink_task_data);
+        client->pending_calls = NULL;
+    }
+    G_OBJECT_CLASS (certification_client_parent_class)->dispose (gobject);
+}
+
+static void
+certification_client_class_init (CertificationClientClass *klass)
+{
+    GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+    g_signal_new ("changed",
+                  G_TYPE_FROM_CLASS (klass),
+                  G_SIGNAL_RUN_LAST,
+                  0,NULL, NULL, NULL,
+                  G_TYPE_NONE,
+                  0);
+
+    object_class->dispose = certification_client_dispose;
+}
+
+static void
+certification_client_init (CertificationClient *self)
+{
+    self->current_status = CERTIFICATION_STATUS_UNKNOWN;
+    self->pending_calls = g_queue_new ();
+}
+
+/**
+ * certification_client_new:
+ *
+ * Creates a new #CertificationClient. It is recommended to use
+ * certification_client_get_default() instead, which returns a
+ * singleton instance, which is shared across the application.
+ *
+ * Returns: (transfer full): a new #CertificationClient
+ */
+CertificationClient *
+certification_client_new (void)
+{
+    return g_object_new (CERTIFICATION_TYPE_CLIENT, NULL);
+}
+
+/**
+ * certification_client_get_default
+ *
+ * Returns the default CertificationClient instance. The transfer is
+ * full, so the caller is responsible for unreffing the returned object.
+ *
+ * Return: (transfer full): the default CertificationClient instance.
+ */
+CertificationClient *
+certification_client_get_default (void)
+{
+    if (default_certification_client == NULL) {
+        default_certification_client = certification_client_new ();
+        g_object_add_weak_pointer (G_OBJECT (default_certification_client), (gpointer) &default_certification_client);
+    } else {
+        g_object_ref (default_certification_client);
+    }
+    return default_certification_client;
+}
