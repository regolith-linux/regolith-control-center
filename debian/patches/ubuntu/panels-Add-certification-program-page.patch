diff --git a/panels/system/certification-client.c b/panels/system/certification-client.c
new file mode 100644
index 0000000..637d116
--- /dev/null
+++ b/panels/system/certification-client.c
@@ -0,0 +1,555 @@
+/* -*- mode: C; c-file-style: "gnu"; indent-tabs-mode: nil; -*-
+ *
