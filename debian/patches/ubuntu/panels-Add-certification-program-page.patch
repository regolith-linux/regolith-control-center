+
+source_path = sys.argv[1]
+build_path = sys.argv[2]
+
+service = varlink.Service(
+    vendor = "Canonical",
+    product = "Certified Ubuntu tester",
+    version = "1",
+    interface_dir = os.path.join(source_path, "../../panels/system")
+)
+
+remote_access_enabled = True
+
+current_test = 0
+tests = [
+    {# check basic communication
+        "client_parameters": ["1", "cache", "NULL"], # the command line parameters to pass to the client
+        "client_source": "cache", # must match the second parameter in "client_parameters"
+        "client_server_url": None, # must match the third parameter in "client_parameters" (even if it is "NULL")
