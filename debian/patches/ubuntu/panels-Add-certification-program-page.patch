+static void
+update_certification_status (CcSystemPanel *self, gpointer user_data)
+{
+    if (!certification_client_get_is_connected (self->certification_client)) {
+        gtk_widget_set_visible (GTK_WIDGET (self->certification_row), false);
+    } else {
+        gtk_widget_set_visible (GTK_WIDGET (self->certification_row), true);
+        if ((certification_client_get_certification_status (self->certification_client) == CERTIFICATION_STATUS_CERTIFIED) &&
+            (certification_client_get_remote_access_enabled (self->certification_client))) {
+            adw_action_row_set_icon_name (ADW_ACTION_ROW (self->certification_row), "org.canonical.certified-symbolic");
+            adw_preferences_row_set_title (ADW_PREFERENCES_ROW (self->certification_row), _("This computer is Ubuntu Certified"));
+        } else {
+            adw_action_row_set_icon_name (ADW_ACTION_ROW (self->certification_row), "org.canonical.certified_unknown-symbolic");
+            adw_preferences_row_set_title (ADW_PREFERENCES_ROW (self->certification_row), _("Check if this computer is Ubuntu Certified"));
+        }
+    }
+}
