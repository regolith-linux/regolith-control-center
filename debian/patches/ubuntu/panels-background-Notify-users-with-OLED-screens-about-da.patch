Subject: panels/background: Notify users with OLED screens about dark theming

---
 panels/background/cc-background-panel.blp | 17 ++++++
 panels/background/cc-background-panel.c   | 97 +++++++++++++++++++++++++++++++
 panels/background/meson.build             |  1 +
 3 files changed, 115 insertions(+)

diff --git a/panels/background/cc-background-panel.blp b/panels/background/cc-background-panel.blp
index ff2b3fb..029e770 100644
--- a/panels/background/cc-background-panel.blp
+++ b/panels/background/cc-background-panel.blp
@@ -116,6 +116,23 @@ template $CcBackgroundPanel: $CcPanel {
             }
           }
 
+          Adw.PreferencesGroup {
