@@ -0,0 +1,115 @@
+using Gtk 4.0;
+using Adw 1;
+
+template $CcTelemetryPage: Adw.NavigationPage {
+  title: _("Telemetry");
+  tag: "telemetry";
+  visible: false;
+
+  child: Adw.ToolbarView {
+    [top]
+    Adw.HeaderBar {}
+
+    content: Box {
+      orientation: vertical;
+
+      $CcPermissionInfobar permission_infobar {
+        visible: false;
+      }
+
+      Adw.PreferencesPage {
+        Adw.PreferencesGroup insights_group {
+          title: _("System Reporting");
+          visible: false;
+
+          Adw.SwitchRow insights_linux_row {
+            title: _("Send a system report every month");
+            sensitive: bind insights_system_opt_out_row.active inverted;
+            has-tooltip: bind insights_system_opt_out_row.active;
+            tooltip-text: _("System reporting is turned off for all users");
+            notify::active => $insights_switch_row_changed_cb();
+          }
+
+          Adw.SwitchRow insights_upgrade_row {
+            title: _("Send a system report when upgrading to a new Ubuntu version");
+            sensitive: bind insights_system_opt_out_row.active inverted;
+            has-tooltip: bind insights_system_opt_out_row.active;
+            tooltip-text: _("System reporting is turned off for all users");
+            notify::active => $insights_switch_row_changed_cb();
+          }
+        }
+
+        Adw.PreferencesGroup insights_system_group {
+          visible: bind insights_group.visible;
+
+          Adw.SwitchRow insights_system_opt_out_row {
+            title: _("Opt out of system reporting for all users");
+            has-tooltip: bind insights_system_opt_out_row.sensitive inverted;
+            tooltip-text: _("Unlock to Change This Setting");
+            notify::active => $insights_system_opt_out_row_changed_cb(template);
+          }
+        }
+
+        Adw.PreferencesGroup insights_buttons_group {
+          separate-rows: true;
+          visible: bind insights_group.visible;
+
+          Adw.ButtonRow insights_example_report_button_row {
+            title: _("_Show Report");
+            use-underline: true;
+            end-icon-name: "go-next-symbolic";
+            activated => $insights_example_report_button_row_activated_cb(template);
+          }
+
+          Adw.ButtonRow insights_cancel_report_button_row {
+            title: _("Cancel Report Generation");
+            visible: false;
+            activated => $insights_cancel_report_button_row_activated_cb(template);
+          }
+
+          LinkButton insights_learn_more_link_button {
+            label: _("Learn more about system reporting");
+            uri: "https://canonical.com/legal/systems-information-notice";
+            margin-top: 8;
+            halign: start;
+
+            styles [
+              "dim",
+              "body",
+              "link-label",
+            ]
+          }
+        }
+
+        Adw.PreferencesGroup diagnostics_group {
+          title: _("Error Reporting");
+
+          Adw.SwitchRow abrt_row {
+            title: _("_Automatic Error Reporting");
+            use-underline: true;
+          }
+
+          Adw.ComboRow whoopsie_combo_row {
+            title: _("Send error reports to Canonical");
+            visible: false;
+            use-underline: true;
+            notify::selected-item => $whoopsie_combo_row_changed_cb(template);
+          }
+
+          LinkButton diagnostics_learn_more_link_button {
+            label: _("Learn more about error reporting");
+            visible: bind $string_is_not_empty(diagnostics_learn_more_link_button.uri) as <bool>;
+            margin-top: 8;
+            halign: start;
+
+            styles [
+              "dim",
+              "body",
+              "link-label",
+            ]
+          }
+        }
+      }
+    };
+  };
+}
