--- /dev/null
+++ b/panels/privacy/telemetry/meson.build
@@ -0,0 +1,42 @@
+ui_sources = files(
+  'cc-telemetry-page.blp',
+)
+
+if enable_insights
+  ui_sources += files('cc-telemetry-insights-example.blp')
+endif
+
+ui_compiled = []
+foreach ui_source : ui_sources
+  ui_compiled += fs.name(fs.replace_suffix(ui_source, '.ui'))
+endforeach
+
+blueprints += custom_target(
+  input: ui_sources,
+  output: ui_compiled,
+  command: [blueprint_compiler, 'batch-compile', '@OUTDIR@', '@CURRENT_SOURCE_DIR@', '@INPUT@']
+)
+
+if enable_insights
+  executable(
+    'gnome-control-center-insights-helper',
+    sources: ['gnome-control-center-insights-helper.c'],
+    dependencies: insights_dep,
+    install: true,
+    install_dir: control_center_libexecdir,
+  )
+
+  i18n.merge_file(
+    input: configure_file(
+      input: 'org.gnome.controlcenter.insights-system-opt-out.policy.in.in',
+      output: '@BASENAME@',
+      configuration: {
+        'libexecdir': control_center_libexecdir,
+      }
+    ),
+    output: '@BASENAME@',
+    po_dir: po_dir,
+    install: true,
+    install_dir: join_paths(control_center_datadir, 'polkit-1', 'actions')
+  )
+endif
