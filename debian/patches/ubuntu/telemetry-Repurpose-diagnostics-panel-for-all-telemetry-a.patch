+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, see <http://www.gnu.org/licenses/>.
+ */
+
+/* Privileged helper that sets the Ubuntu Insights system-wide opt-out state.
+ * Intended to be launched via pkexec, which enforces the
+ * org.gnome.controlcenter.insights-system-opt-out polkit action. */
+
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <insights/insights.h>
+
+int
+main (int   argc,
+      char *argv[])
+{
+  char *error_msg = NULL;
+  bool  state;
+
+  if (argc != 2)
+    {
+      fprintf (stderr, "Usage: %s true|false\n", argv[0]);
+      return EXIT_FAILURE;
+    }
+
+  if (strcmp (argv[1], "true") == 0)
+    state = true;
+  else if (strcmp (argv[1], "false") == 0)
+    state = false;
+  else
+    {
+      fprintf (stderr, "%s: invalid state '%s', expected true or false\n", argv[0], argv[1]);
+      return EXIT_FAILURE;
+    }
+
+  error_msg = insights_set_system_opt_out_state (NULL, state);
+  if (error_msg != NULL)
+    {
+      fprintf (stderr, "Failed to set system opt-out state: %s\n", error_msg);
+      free (error_msg);
+      return EXIT_FAILURE;
+    }
+
+  return EXIT_SUCCESS;
+}
diff --git a/panels/privacy/telemetry/meson.build b/panels/privacy/telemetry/meson.build
new file mode 100644
