+#include <config.h>
+
+#include <glib/gi18n.h>
+
+#include "cc-telemetry-insights-example.h"
+#include "glib.h"
+#include "gtk/gtk.h"
+#include "gtk/gtkshortcut.h"
+
+#define DOCUMENTATION_URL "https://github.com/ubuntu/ubuntu-insights#example-insights-reports"
+#define INSIGHTS_CACHE_SUBDIR ".cache/ubuntu-insights"
+
+struct _CcTelemetryInsightsExample
+{
+  AdwWindow parent_instance;
+
+  GtkWidget   *subtitle_label;
+  GtkTextView *report_view;
+};
+
+G_DEFINE_TYPE (CcTelemetryInsightsExample, cc_telemetry_insights_example, ADW_TYPE_WINDOW)
+
+static void
+cc_telemetry_insights_example_class_init (CcTelemetryInsightsExampleClass *klass)
+{
+  GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
+
+  gtk_widget_class_add_binding_action (widget_class, GDK_KEY_Escape, 0, "window.close", NULL);
+
+  gtk_widget_class_set_template_from_resource (widget_class,
+                                               "/org/gnome/control-center/privacy/telemetry/cc-telemetry-insights-example.ui");
+
+  gtk_widget_class_bind_template_child (widget_class, CcTelemetryInsightsExample, subtitle_label);
+  gtk_widget_class_bind_template_child (widget_class, CcTelemetryInsightsExample, report_view);
+}
+
+static void
+cc_telemetry_insights_example_init (CcTelemetryInsightsExample *self)
+{
+  g_autofree gchar *path = NULL;
+  g_autofree gchar *url = NULL;
+  g_autofree gchar *subtitle = NULL;
+  g_autofree gchar *cache_path = NULL;
+  g_autofree gchar *cache_uri = NULL;
+  g_autofree gchar *display_path = NULL;
+
+  gtk_widget_init_template (GTK_WIDGET (self));
+
+  cache_path = g_build_filename (g_get_home_dir (), INSIGHTS_CACHE_SUBDIR, NULL);
+  display_path = g_strdup_printf ("~/%s", INSIGHTS_CACHE_SUBDIR);
+
+  if (g_file_test (cache_path, G_FILE_TEST_IS_DIR))
+    {
+      cache_uri = g_filename_to_uri (cache_path, NULL, NULL);
+      path = g_strdup_printf ("<a href=\"%s\"><span face=\"monospace\" allow_breaks=\"false\">%s</span></a>",
+                              cache_uri,
+                              display_path);
+    }
+  else
+    {
+      path = g_strdup_printf ("<span face=\"monospace\" allow_breaks=\"false\">%s</span>",
+                              display_path);
+    }
+
+  /* translators: The '%s' is a file path to the local Ubuntu Insights cache directory */
+  subtitle = g_strdup_printf (_ ("This is a system report example with real data from this computer. "
+                                 "System reports are temporarily stored in %s before being sent to Canonical."),
+                              path);
+  gtk_label_set_markup (GTK_LABEL (self->subtitle_label), subtitle);
+}
+
+GtkWidget *
+cc_telemetry_insights_example_new (const gchar *report)
+{
+  CcTelemetryInsightsExample *self;
+  self = g_object_new (CC_TYPE_TELEMETRY_INSIGHTS_EXAMPLE, NULL);
+
+  gtk_text_buffer_set_text (gtk_text_view_get_buffer (self->report_view),
+                            report,
+                            -1);
+  return GTK_WIDGET (self);
+}
