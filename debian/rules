#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_CPPFLAGS_MAINT_APPEND = -DSSHD_SERVICE=\"ssh.service\"
export DEB_LDFLAGS_MAINT_APPEND = -Wl,-O1 -Wl,-z,defs

DISTRIBUTOR_LOGO := /usr/share/icons/regolith-logo.png
DISTRIBUTOR_LOGO_DARK := /usr/share/icons/regolith-logo.png


%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- \
		-Dprivileged_group=sudo \
		-Dssh_socket_activation=true \
		-Ddocumentation=true \
		-Ddistributor_logo=$(DISTRIBUTOR_LOGO) \
		-Ddark_mode_distributor_logo=$(DISTRIBUTOR_LOGO_DARK) \
		-Dmalcontent=$(if $(filter linux,$(DEB_HOST_ARCH_OS)),true,false)

# gtk_test_init() switches the GTK tests to en_US.UTF-8. Builders usually
# have only C.UTF-8, and GTK 4.24 makes the missing locale a fatal warning.
override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	mkdir -p debian/test-locales
	localedef -i en_US -f UTF-8 debian/test-locales/en_US.UTF-8
	LOCPATH=$(CURDIR)/debian/test-locales dh_auto_test
endif

# Ubuntu-specific
override_dh_translations:
	dh_translations --domain=regolith-control-center-2.0

override_dh_gnome_clean:
